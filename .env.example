# LLM (pick one provider; Gemini is the default)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
MLIA_LLM_PROVIDER=gemini          # gemini | openai | anthropic | fake
# MLIA_LLM_MODEL=gemini-3.1-flash-lite

# Search: auto = Tavily > Exa > DuckDuckGo (free). "fixtures" = offline demo pages.
MLIA_SEARCH_PROVIDER=auto
# TAVILY_API_KEY=
# EXA_API_KEY=
MLIA_MAX_QUERIES=12
MLIA_MAX_PAGES=30
MLIA_USE_BROWSER=true

# Storage: SQLite by default; Postgres (Neon/Render/docker-compose):
# MLIA_DATABASE_URL=postgresql://mlia:mlia@localhost:5432/mlia

# Optional
# MLIA_CRM_WEBHOOK_URL=https://hooks.example.com/crm
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
